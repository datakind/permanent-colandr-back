# Copy this file to:
#   `.env` — local dev (`compose.yaml`), prod host (`compose.prod.yaml` `api` / `worker`), and variable interpolation.
#   `develop` checkout — same file name `.env` inside that directory (git worktree or second clone; see README).
#     Set `COLANDR_DEVELOP_BUILD_CONTEXT` in the **production** clone’s `.env` to that path; `api-develop` loads
#     `${COLANDR_DEVELOP_BUILD_CONTEXT}/.env` and builds from that tree (`compose.prod.yaml --profile develop`).
#     Host data dir for develop defaults to `./colandr_data_develop` (paths are relative to the compose project dir).

BUILD_TARGET=dev
# secret keys
COLANDR_SECRET_KEY="<YOUR_SECRET_KEY>"
COLANDR_JWT_SECRET_KEY="<COLANDR_JWT_SECRET_KEY>"
# database connection
COLANDR_DB_USER="<COLANDR_DB_USER>"
COLANDR_DB_PASSWORD="<COLANDR_DB_PASSWORD>"
COLANDR_DB_NAME="<COLANDR_DB_NAME>"
COLANDR_DATABASE_URI="postgresql://${COLANDR_DB_USER}:${COLANDR_DB_PASSWORD}@localhost:5432/${COLANDR_DB_NAME}"

# email server
COLANDR_MAIL_SERVER=colandr-email
COLANDR_MAIL_PORT=1025
COLANDR_MAIL_USERNAME="<COLANDR_MAIL_USERNAME>"
COLANDR_MAIL_PASSWORD="<COLANDR_MAIL_PASSWORD>"
COLANDR_MAIL_USE_TLS=0
COLANDR_MAIL_USE_SSL=0
# filesystem storage
COLANDR_APP_DIR="/app"
# file-based filesystem
COLANDR_FILESYSTEM_PROTOCOL="file"
COLANDR_FILESYSTEM_ROOT_DIR="/app/data"
COLANDR_FILESYSTEM_GCS_ENDPOINT_URL="http://colandr-gcs:4443"  # dev-only hack for gcs
# gcs-based filesystem
# COLANDR_FILESYSTEM_PROTOCOL="gcs"
# COLANDR_FILESYSTEM_ROOT_DIR="<GCS_BUCKET>"
# COLANDR_FILESYSTEM_GCS_PROJECT="<GCS_PROJECT>"
# COLANDR_FILESYSTEM_GCS_TOKEN="<GCS_TOKEN>"
# metadata extraction config
COLANDR_METADATA_THRESHOLD=0.65
COLANDR_METADATA_INCREASE_TO_RETRAIN=5
COLANDR_METADATA_MIN_TO_TRAIN=40
# misc
# COLANDR_FE_APP_SITE="https://colandr.datakind.org"  # prod-only!

# --- `compose.prod.yaml` (project `.env` for variable interpolation; prod + develop `.env` in each tree) ---
# `COLANDR_DEVELOP_BUILD_CONTEXT=/absolute/path/to/develop-checkout`  # api-develop build, scripts/, and env file path (see README)
# Celery / Redis (service name `broker`). In the **develop** tree’s `.env`, prefer Redis DB `/1` so dev tasks are
# not consumed by the prod worker unless you add a develop worker:
# COLANDR_CELERY_BROKER_URL="redis://broker:6379/1"
# COLANDR_CELERY_RESULT_BACKEND="redis://broker:6379/1"
