# Use a minimal image for production (e.g., an Alpine-based image with Python)
FROM python:3.9-slim AS base

# Set the working directory
WORKDIR /app

# Install dependencies (use a requirements.txt)
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# Copy the app files
COPY . /app

# Set the environment to production
ENV FLASK_ENV=production
ENV FLASK_APP=colandr.app:create_app()

# Expose the application port
EXPOSE 5000

# Use a production server (e.g., Gunicorn)
CMD ["gunicorn", "-b", "0.0.0.0:5000", "colandr.app:create_app()"]
